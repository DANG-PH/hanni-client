# Copy thành .env.local

# URL gốc của hanni-server (bao gồm prefix /api). Phải cùng host với client để
# cookie phiên (host-only) được gửi kèm request.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Client ID Google (công khai) cho nút "Đăng nhập với Google".
# Trùng với GOOGLE_CLIENT_ID ở hanni-server/.env. Trong Google Cloud Console,
# OAuth client (Web application) phải có "Authorized JavaScript origins" = http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Tên hiển thị app
NEXT_PUBLIC_APP_NAME=Hanni

# URL công khai của web (sitemap, robots, ảnh xem trước khi chia sẻ link). Bỏ trống: trên Vercel tự lấy
# VERCEL_PROJECT_PRODUCTION_URL, local là http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Mã xác minh Google Search Console (cách "Thẻ HTML" → chỉ chép phần content="…"). Đặt trên Vercel, layout tự gắn
# thẻ meta; xác minh xong nộp https://<domain>/sitemap.xml ở Search Console. Bỏ trống = không gắn.
GOOGLE_SITE_VERIFICATION=

# Production (Vercel): biến đặt ở Project → Settings → Environment Variables, KHÔNG đọc file trên máy bạn.
